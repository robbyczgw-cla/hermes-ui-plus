{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermes UI+",
  "version": "0.1.0-alpha.1",
  "identifier": "xyz.hermesui.desktop",
  "build": {
    "frontendDist": "../dist-web"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com https://esm.sh",
        "style-src": "'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com https://esm.sh",
        "font-src": "'self' data: https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com https://esm.sh",
        "img-src": "'self' data: blob: https:",
        "media-src": "'self' data: blob: https:",
        "connect-src": "'self' ipc: http://ipc.localhost https:",
        "worker-src": "'self' blob:",
        "frame-src": "'self' blob: data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["script-src", "style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Interactive chat for Hermes Agent",
    "copyright": "Hermes Interactive UI+ contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "entitlements": "./Entitlements.plist"
    },
    "linux": {
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
