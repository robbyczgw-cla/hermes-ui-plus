{
  "expo": {
    "name": "Hermes UI+",
    "slug": "hermes-ui-plus",
    "version": "0.1.0-alpha.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "xyz.hermesui.app",
      "buildNumber": "1",
      "deploymentTarget": "26.0",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "CFBundleAllowMixedLocalizations": true,
        "NSPhotoLibraryAddUsageDescription": "Hermes saves images from the chat to your photo library when you choose Save Image.",
        "NSLocalNetworkUsageDescription": "Hermes connects to your Hermes server or bridge on your local network."
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F131A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "xyz.hermesui.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "lang": "de"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Hermes needs access to your photos to attach images to messages.",
          "cameraPermission": "Hermes uses the camera to take photos for your messages and to scan pairing codes (QR).",
          "microphonePermission": "Hermes uses the microphone so you can dictate messages. The recording is only used for speech recognition."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Hermes uses the microphone so you can dictate messages. The recording is only used for speech recognition.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Hermes uses the camera to take photos for your messages and to scan pairing codes (QR).",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Hermes adds events to your calendar when you confirm it in the chat.",
          "remindersPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563EB"
        }
      ],
      "expo-web-browser",
      "expo-localization",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Hermes uses the microphone so you can dictate messages. The recording is only used for speech recognition.",
          "speechRecognitionPermission": "Hermes uses your device's speech recognition to turn dictation into text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as",
            "com.google.android.tts"
          ]
        }
      ],
      "./plugins/withSceneLifecycle.js",
      "./plugins/withIosRelease.js"
    ],
    "scheme": "hermesuiplus",
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "de": "./locales/ios-de.json",
      "en": "./locales/ios-en.json"
    }
  }
}
